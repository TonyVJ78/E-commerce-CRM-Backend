# Kantu Market — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
.env
.env.*
!.env.example


# Django
db.sqlite3
staticfiles/
media/

# Database Backups (Kantu Market DR)
server/backups/*.sql.gz
server/backups/*.dump
server/backups/*.sql
!server/backups/.gitkeep

# Node / Angular
node_modules/
client/dist/
client/.angular/
client/.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db

# Scratch / dev scripts
scratch/
movil/


# Firebase server credentials are provisioned outside Git
/secrets/firebase-admin.json
**/*firebase-adminsdk*.json
