# ==============================================================================
# Kantu Market — Variables de entorno
# Copia este archivo como .env y reemplaza los valores con los tuyos.
# ==============================================================================

# --- Django ---
SECRET_KEY=cambia-esto-por-una-clave-secreta-segura
DEBUG=True
ALLOWED_HOSTS=*

# --- Base de datos PostgreSQL ---
DB_NAME=kantu_market
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=prefer
DB_CHANNEL_BINDING=prefer

# --- Variables para el contenedor PostgreSQL ---
POSTGRES_DB=kantu_market
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Email (consola para desarrollo) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@kantumarket.com

# --- Frontend URL (para links en correos) ---
FRONTEND_URL=http://localhost:4200

# --- Cloudinary ---
# Las credenciales reales deben agregarse solamente en .env por el responsable
# del ambiente. Nunca incluir CLOUDINARY_API_SECRET en Angular o en el codigo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Stripe (CU-19 — checkout con pasarela de pagos) ---
# Claves de prueba desde https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY nunca debe llegar a Angular/Flutter, solo el backend la usa.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Tipo de cambio USD/BOB: Stripe no cobra en bolivianos, así que el monto del
# carrito se convierte a USD con esta tasa antes de crear el PaymentIntent.
STRIPE_USD_BOB_RATE=10.99

# --- Chatbot de recomendaciones (Claude) ---
# Clave de https://console.anthropic.com/. Sin ella /api/ia/chatbot/ responde 503.
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-haiku-4-5
# Mensajes por usuario permitidos (cada uno consume la API de Claude).
CHATBOT_THROTTLE_RATE=20/min

# --- Recomendaciones personalizadas (CU-14) ---
# Sin clave (o con AI_RECOMMENDATIONS_ENABLED=False) el ranking es solo
# determinístico; con ella OpenAI reordena los candidatos ya filtrados.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_RECOMMENDATIONS_ENABLED=False
