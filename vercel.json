{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "client",
      "framework": "angular",
      "outputDirectory": "dist/client/browser"
    },
    "backend": {
      "root": "server",
      "framework": "django"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
